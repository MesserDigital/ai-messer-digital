# SMTP (contact form)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO=hello@messerdigital.com

# ── AI chat provider ──────────────────────────────────────────────
# One of: ollama | anthropic | openai | builtin
# Leave unset to auto-detect: ollama if OLLAMA_URL is set, anthropic if
# ANTHROPIC_API_KEY is set, then openai, otherwise builtin (no LLM needed).
AI_PROVIDER=

# Local Ollama (once the GPU server is up)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Anthropic Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
